{
  "name": "spotmap-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "npm run test:tools && ng build --configuration production --output-path=../dist/spotmap-website --base-href /spotmap-website/ && npm run verify:map-worker-assets && npm run verify:css-asset-urls",
    "verify:map-worker-assets": "node tools/verify-map-worker-assets.mjs ../dist/spotmap-website/browser",
    "verify:css-asset-urls": "node tools/verify-css-asset-urls.mjs ../dist/spotmap-website/browser",
    "verify:dev-map-worker": "node tools/verify-dev-server-map-worker.mjs",
    "extract:spots": "node tools/extract-spots/cli.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\""
  },
  "private": true,
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "dependencies": {
    "@angular/animations": "^22.0.5",
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/material": "^22.0.3",
    "@angular/platform-browser": "^22.0.5",
    "@angular/platform-browser-dynamic": "^22.0.5",
    "@angular/router": "^22.0.5",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jasmine": "~5.1.0",
    "fast-xml-parser": "^5.11.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3"
  }
}
