{
  "name": "spotmap-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "npm run test:tools && ng build --configuration production --output-path=../dist/spotmap-website --base-href /spotmap-website/ && npm run verify:map-worker-assets && npm run verify:css-asset-urls",
    "verify:map-worker-assets": "node tools/verify-map-worker-assets.mjs ../dist/spotmap-website/browser",
    "verify:css-asset-urls": "node tools/verify-css-asset-urls.mjs ../dist/spotmap-website/browser",
    "verify:dev-map-worker": "node tools/verify-dev-server-map-worker.mjs",
    "extract:spots": "node tools/extract-spots/cli.mjs",
    "db:start": "supabase start -x studio,mailpit,realtime,edge-runtime,logflare,vector,supavisor,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "sync:supabase": "node --env-file-if-exists=.env.local tools/sync-supabase/cli.mjs",
    "snapshot:supabase": "node --env-file-if-exists=.env.local tools/sync-supabase/snapshot.mjs",
    "parity:supabase": "node --env-file-if-exists=.env.local tools/sync-supabase/parity.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\""
  },
  "private": true,
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@jsquash/webp": "^1.5.0",
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "exifr": "^7.1.3",
    "heic-to": "^1.6.6",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.14.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "fast-xml-parser": "^5.11.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "2.120.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3"
  }
}
