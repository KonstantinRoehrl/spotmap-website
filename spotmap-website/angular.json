{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "spotmap-website": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/spotmap-website",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "maplibre-gl-worker.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "."
              },
              {
                "glob": "maplibre-gl-shared.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "."
              },
              {
                "glob": "*.wasm",
                "input": "node_modules/@jsquash/webp/codec/enc",
                "output": "jsquash"
              }
            ],
            "styles": [
              "src/theme.scss",
              "src/styles.css",
              "node_modules/maplibre-gl/dist/maplibre-gl.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                // The error ceiling leaves room for the spot map's DOM selection flag, which
                // lives in its component stylesheet.
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "3kB",
                  "maximumError": "10kB"
                },
                // The two lazy chunks the map's first view pulls, each sized to the build that
                // was measured when the ceiling was set — maplibre-gl 1.07 MB, map-component
                // 245.48 kB — so growth warns instead of a round number never being reached.
                // The map-component ceiling was raised to 360 kB when the photo viewer landed
                // (measured 356.32 kB), while the city picker's Material still sat in it. The
                // picker is now deferred (`@defer` in map.component.html), so Material and
                // `@angular/forms` load on idle from the city picker's own chunk and the CDK
                // overlay from a lazy chunk the picker shares with the photo viewer; the chunk
                // measured 126.39 kB. Lowering its ceilings to match is follow-up work.
                // `minimumWarning` guards the budget itself: a renamed chunk matches nothing,
                // reads 0 bytes and would otherwise pass in silence. The worker's copy of
                // maplibre-gl-shared.mjs is a copied asset, not a bundler output, and budgets
                // are computed from .js and .css outputs alone, so no budget can watch it.
                {
                  "type": "bundle",
                  "name": "maplibre-gl",
                  "maximumWarning": "1100kB",
                  "maximumError": "1250kB",
                  "minimumWarning": "700kB"
                },
                {
                  "type": "bundle",
                  "name": "map-component",
                  "maximumWarning": "265kB",
                  "maximumError": "360kB",
                  "minimumWarning": "120kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": {
              "exclude": ["maplibre-gl"]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "spotmap-website:build:production"
            },
            "development": {
              "buildTarget": "spotmap-website:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "*.wasm",
                "input": "node_modules/@jsquash/webp/codec/enc",
                "output": "jsquash"
              }
            ],
            "styles": ["src/theme.scss", "src/styles.css"],
            "scripts": []
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
