# tools/sync-supabase (npm run sync:supabase, npm run snapshot:supabase) reads these from
# spotmap-website/.env.local (gitignored; copy this file there) or from the environment, which
# wins. Local stack: `npx supabase status -o env` prints them as API_URL and SECRET_KEY.
# Hosted project: Project Settings → API Keys.
SUPABASE_URL=
# The secret key (sb_secret_…): never the publishable key, never the legacy service_role JWT,
# never committed.
SUPABASE_SECRET_KEY=
