# tools/sync-supabase (npm run sync:supabase, npm run parity:supabase) reads these from
# spotmap-website/.env.local (gitignored; copy this file there) or from the environment, which
# wins. Local stack: `npx supabase status -o env` prints them as API_URL and SECRET_KEY.
# Hosted project: Project Settings → API Keys.
SUPABASE_URL=
# The secret key (sb_secret_…): never the publishable key, never the legacy service_role JWT,
# never committed.
SUPABASE_SECRET_KEY=
# Optional, parity:supabase only: a publishable key (sb_publishable_…). When set, the parity
# check reads as the public (like the browser) instead of with the secret key; CI sets it. Local
# stack: PUBLISHABLE_KEY in `npx supabase status -o env`.
SUPABASE_PUBLISHABLE_KEY=
